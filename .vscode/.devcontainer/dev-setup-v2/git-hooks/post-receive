#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# post-receive  —  install at ~/dev/localhost.git/hooks/post-receive
#
# Triggered on every push to the WSL bare hub.
# Fans out to: Windows bare repo  |  GitHub  |  Oracle VPS
# Also updates the WSL working tree checkout.
# ─────────────────────────────────────────────────────────────────────────────

BARE_DIR="$HOME/dev/localhost.git"
WORK_DIR="$HOME/dev/localhost"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; RESET='\033[0m'

log()  { echo -e "${GREEN}[sync]${RESET} $*"; }
warn() { echo -e "${RED}[sync] ✗ $*${RESET}"; }
push_remote() {
    local name="$1"
    local url
    url=$(git -C "$BARE_DIR" remote get-url "$name" 2>/dev/null || true)
    [ -z "$url" ] && return
    echo -e "${YELLOW}  → $name${RESET}"
    if git -C "$BARE_DIR" push "$name" "${branch}:${branch}" --quiet 2>&1; then
        log "✓ $name synced"
    else
        warn "$name push failed — will retry on next push"
    fi
}

while read -r oldrev newrev refname; do
    branch="${refname#refs/heads/}"
    log "received push → branch: $branch"

    # ── 1. Update WSL working tree ────────────────────────────────────────────
    git --work-tree="$WORK_DIR" --git-dir="$BARE_DIR" checkout -f "$branch" 2>/dev/null
    log "✓ WSL working tree updated"

    # ── 2. Windows bare repo (git push over WSL↔Windows bridge) ──────────────
    #    Only metadata/delta crosses the boundary — fast even with the VM overhead
    push_remote "windows"

    # ── 3. GitHub ─────────────────────────────────────────────────────────────
    push_remote "github"

    # ── 4. Oracle VPS ─────────────────────────────────────────────────────────
    push_remote "vps"
done

log "sync complete ✓"
