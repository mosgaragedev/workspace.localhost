    "@types/react": "^19.2.18",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.8",
    "unbuild": "^3.6.1",
    "vue": "^3.5.41"
  },
  "scripts": {
