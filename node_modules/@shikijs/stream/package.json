    "directory": "packages/stream"
  },
  "bugs": "https://github.com/shikijs/shiki/issues",
  "keywords": [
    "shiki",
    "@shikijs/stream",
    "streaming",
    "llm"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
